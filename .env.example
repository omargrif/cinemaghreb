# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# --- Data collection (Phase 1) ---
# Free key from https://www.themoviedb.org/settings/api (v3 auth, "API Key" field)
TMDB_API_KEY=

# Optional. Free key from https://www.omdbapi.com/apikey.aspx (1000 req/day).
# Used only to backfill a synopsis for films found via the IMDb datasets
# but absent from TMDB. The pipeline works without it (those films just
# keep synopsis=null and show up in the completeness report).
OMDB_API_KEY=

# --- Ambiance enrichment (Phase 2) ---
# Free key from https://aistudio.google.com/app/apikey — used once per movie
# to generate ambiance tags + a short mood summary from the synopsis, via the
# Gemini API free tier. The pipeline reports how many movies it skipped (no
# synopsis to work from) rather than guessing.
GEMINI_API_KEY=

# --- Database ---
# SQLite by default — no install needed for local dev. Point this at
# postgresql+psycopg://user:pass@host:5432/db for production.
DATABASE_URL=sqlite:///../data/cinemaghreb.db

# --- Auth (Phase 4) ---
JWT_SECRET=change-me-to-a-random-string

# --- Local paths (defaults are fine for local dev) ---
DATA_RAW_DIR=../data/raw
DATA_PROCESSED_DIR=../data/processed
CHROMA_PERSIST_DIR=../data/chroma_db
